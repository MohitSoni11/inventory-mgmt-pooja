<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inventory Position</title>
</head>

<body>
  <div>
    <% inventory_position.forEach(item=> { %>
      <p>Name: <%= item.name %>
      </p>
      <p>Available Stock: <%= item.stock %>
      </p>
      <br><br>
      <% }); %>
  </div>
</body>

</html>