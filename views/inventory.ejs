<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inventory Position</title>
</head>

<body>
  <div>
    <% purchases.forEach(purchase=> { %>
      <p>Name: <%= purchase._id %>
      </p>
      <p>Total Stock: <%= purchase.totalStock - (salesMap.get(purchase._id) || 0) %>
      </p>
      <br><br>
      <% }); %>
  </div>
</body>

</html>